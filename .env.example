# Copy to .env.local and fill in. Never commit real values.
# Only VITE_-prefixed vars reach the browser (safe: public keys / IDs).

# Firebase (Project settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Stripe — OPTIONAL, only if you add a paid tier (publishable key only)
VITE_STRIPE_PUBLISHABLE_KEY=
