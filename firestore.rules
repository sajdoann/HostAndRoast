rules_version = '2';

// Host & Roast — starter security rules for the rating game.
//
// The core rule: raw ratings are NEVER readable by clients — not even the
// organizer — so scores stay sealed. A Cloud Function computes the leaderboard
// and writes it to /results/{seasonId} only once the reveal condition is met.
// TODO(rules): tighten season writes once organizer auth exists (see ROADMAP).
service cloud.firestore {
  match /databases/{database}/documents {

    function scores() {
      return request.resource.data.scores;
    }
    function validScore(v) {
      return v is int && v >= 1 && v <= 10;
    }

    // Season doc: schedule, players and public join codes.
    // Publicly readable so guests can join by code without an account.
    // Only the signed-in organizer who created it may change or delete it —
    // participants can't touch anyone's season.
    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Ratings live in a subcollection and are write-once, read-never.
      // Deterministic id "<eventId>_<raterId>" makes a second submission an
      // update, which is denied → one rating per guest per dinner.
      match /ratings/{ratingId} {
        allow read: if false;
        allow create: if validScore(scores().food)
                      && validScore(scores().atmosphere)
                      && validScore(scores().entertainment);
        allow update, delete: if false;
      }
    }

    // Receipts carry NO scores — just who rated — so the client can show
    // "3 of 5 rated" and evaluate the reveal condition without leaking scores.
    // Written together with the rating (same deterministic id), write-once.
    // A recursive match is required so the client's collectionGroup("receipts")
    // listener is authorized (a nested-only rule would be denied).
    match /{path=**}/receipts/{receiptId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Published leaderboard — exists only after reveal, written by a Function.
    match /results/{seasonId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
