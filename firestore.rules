rules_version = '2';

// Host & Roast — security rules.
//
// Access model:
//   - Schedule + dinners: readable by anyone with the season's link (get), but
//     not listable publicly (list is owner-only) — "anyone with the link".
//   - Organizer (owner): full control of their season and dinners.
//   - Cook: signs in, claims which player they are, then edits only their own
//     dinner's date/menu.
//   - Guests: rate with no login. Raw scores are never client-readable.
service cloud.firestore {
  match /databases/{database}/documents {

    function scores() { return request.resource.data.scores; }
    function validScore(v) { return v is int && v >= 1 && v <= 10; }

    // The player id the signed-in user claimed in this season (or null).
    function claimedPlayer(sid) {
      return exists(/databases/$(database)/documents/seasons/$(sid)/claims/$(request.auth.uid))
        ? get(/databases/$(database)/documents/seasons/$(sid)/claims/$(request.auth.uid)).data.playerId
        : null;
    }

    match /seasons/{sid} {
      allow get: if true;                                     // anyone with the link
      allow list: if request.auth != null
                  && resource.data.ownerId == request.auth.uid;   // only your own
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Dinners. ownerId is denormalized so create needs no cross-doc read.
      match /events/{eid} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.ownerId == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.ownerId == request.auth.uid;
        // Owner edits anything; the claimed cook edits only date/menu of their
        // own dinner (hostId, code and ownerId must stay unchanged).
        allow update: if request.auth != null && (
          resource.data.ownerId == request.auth.uid
          || ( claimedPlayer(sid) == resource.data.hostId
               && request.resource.data.hostId == resource.data.hostId
               && request.resource.data.code == resource.data.code
               && request.resource.data.ownerId == resource.data.ownerId )
        );
      }

      // Identity: a signed-in participant claims which player they are.
      match /claims/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Scores — write-once, read-never.
      match /ratings/{ratingId} {
        allow read: if false;
        allow create: if validScore(scores().food)
                      && validScore(scores().atmosphere)
                      && validScore(scores().entertainment);
        allow update, delete: if false;
      }

      // Receipts: who rated, no scores. Public so progress + reveal can be
      // shown. A receipt may only be created once its matching rating exists
      // (same id) — so progress can't be faked with a bare receipt.
      match /receipts/{receiptId} {
        allow read: if true;
        allow create: if exists(
          /databases/$(database)/documents/seasons/$(sid)/ratings/$(receiptId)
        );
        allow update, delete: if false;
      }
    }

    // Join-code lookup: read one by code; not listable.
    match /codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Published leaderboard — written by a Cloud Function on reveal.
    match /results/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    // Private per-user index of seasons they participate in.
    match /users/{uid}/memberships/{seasonId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
